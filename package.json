{
  "name": "teamops",
  "version": "2.0.0-alpha.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "TeamOps: design, govern and run teams of AI agents across engines (Claude Code, OpenCode and more).",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch packages/server/src/index.ts",
    "dev:web": "npm -w @teamops/web run dev",
    "build": "npm -w @teamops/web run build",
    "start": "tsx packages/server/src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test packages/*/test/*.test.ts",
    "db:generate": "drizzle-kit generate --config packages/server/drizzle.config.ts",
    "seed:demo": "tsx packages/server/src/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
