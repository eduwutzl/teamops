{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true, "noEmit": true,
    "jsx": "react-jsx", "resolveJsonModule": true, "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["node", "vite/client"],
    "baseUrl": ".", "paths": { "@/*": ["packages/web/src/*"] }
  },
  "include": ["packages/*/src", "packages/*/test"]
}
